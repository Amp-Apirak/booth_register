# Backend Server configurations
PORT=3005

# Database configurations (must match the root .env used by docker-compose)
DB_HOST=localhost
DB_PORT=5435
DB_USER=event_admin
DB_PASSWORD=change_me
DB_NAME=booth_register_db

# JWT signing secret for staff login — generate with: openssl rand -hex 32
JWT_SECRET=change_me

# Redis configurations
REDIS_HOST=localhost
REDIS_PORT=6385

# SMTP Email server configurations (For optional production SMTP)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
